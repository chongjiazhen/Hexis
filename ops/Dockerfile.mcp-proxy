FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY pyproject.toml /app/
COPY README.md /app/README.md
COPY apps /app/apps
COPY core /app/core
COPY services /app/services
RUN pip install --no-cache-dir . && pip install --no-cache-dir mcp-proxy
# DSN from POSTGRES_* env (see apps/hexis_mcp_server._env_dsn).
# --pass-environment: MCP stdio client sanitizes child env by default, stripping
# POSTGRES_* — without this the wrapped hexis-mcp falls back to localhost:43815.
CMD ["mcp-proxy", "--pass-environment", "--host", "0.0.0.0", "--port", "8765", "hexis-mcp"]
